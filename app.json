{
  "expo": {
    "name": "Serlo",
    "slug": "vibes",
    "version": "1.30.0",
    "scheme": "vibes",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "updates": {
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/02ab536a-5836-4560-a5ec-2dfd6e059f90"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#070707"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.vibesapp.vibes",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Serlo verwendet die Kamera, damit du Videos und Fotos direkt in der App aufnehmen und als Beitrag, Story oder Live-Stream teilen kannst – zum Beispiel um ein kurzes Video aufzunehmen und in deinem Feed zu posten.",
        "NSMicrophoneUsageDescription": "Serlo verwendet das Mikrofon, um Ton für deine Videos, Stories und Live-Streams aufzunehmen – zum Beispiel um ein Video mit deiner Stimme aufzunehmen und zu teilen.",
        "NSPhotoLibraryUsageDescription": "Serlo greift auf deine Mediathek zu, damit du vorhandene Fotos und Videos auswählen und als Beitrag oder Story hochladen kannst – zum Beispiel um ein Video aus deiner Galerie in deinem Feed zu teilen.",
        "NSPhotoLibraryAddUsageDescription": "Serlo speichert Fotos und Videos in deiner Mediathek, wenn du einen Beitrag herunterlädst – zum Beispiel um ein gespeichertes Video später offline anzusehen.",
        "UIStatusBarStyle": "UIStatusBarStyleLightContent",
        "UIViewControllerBasedStatusBarAppearance": false,
        "UIApplicationSceneManifest": {
          "UIApplicationSupportsMultipleScenes": false
        }
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": [
              "E174.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          }
        ]
      },
      "entitlements": {
        "aps-environment": "production",
        "com.apple.developer.applesignin": [
          "Default"
        ]
      },
      "buildNumber": "291"
    },
    "android": {
      "package": "app.serlo.social",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.ACCESS_MEDIA_LOCATION",
        "android.permission.READ_MEDIA_AUDIO"
      ],
      "versionCode": 47
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-video",
      "expo-camera",
      [
        "react-native-vision-camera",
        {
          "cameraPermissionText": "Serlo verwendet die Kamera, damit du Videos und Fotos direkt in der App aufnehmen und als Beitrag, Story oder Live-Stream teilen kannst – zum Beispiel um ein kurzes Video aufzunehmen und in deinem Feed zu posten.",
          "microphonePermissionText": "Serlo verwendet das Mikrofon, um Ton für deine Videos, Stories und Live-Streams aufzunehmen – zum Beispiel um ein Video mit deiner Stimme aufzunehmen und zu teilen.",
          "enableFrameProcessors": true
        }
      ],
      "expo-image-picker",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#FFFFFF",
          "sounds": []
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.0",
            "newArchEnabled": true,
            "buildReactNativeFromSource": true
          }
        }
      ],
      "./plugins/withFmtConstevalFix",
      "./plugins/withRootViewBackground",
      "@livekit/react-native-expo-plugin",
      "expo-font",
      "expo-apple-authentication",
      [
        "expo-media-library",
        {
          "photosPermission": "Serlo greift auf deine Mediathek zu, damit du vorhandene Fotos und Videos auswählen und als Beitrag oder Story hochladen kannst – zum Beispiel um ein Video aus deiner Galerie in deinem Feed zu teilen.",
          "savePhotosPermission": "Serlo speichert Fotos und Videos in deiner Mediathek, wenn du einen Beitrag herunterlädst – zum Beispiel um ein gespeichertes Video später offline anzusehen.",
          "isAccessMediaLocationEnabled": true
        }
      ],
      "expo-audio",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "02ab536a-5836-4560-a5ec-2dfd6e059f90"
      }
    },
    "owner": "zaurhat"
  }
}
