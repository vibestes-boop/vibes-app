# Expo SDK 54 pinnt react@19.1.0, während react-dom transitiv als 19.2.8
# hereinkommt und react@^19.2.8 verlangt. Der Konflikt ist folgenlos — react-dom
# wird von Berkat gar nicht benutzt, es hängt nur als optionaler Peer an
# expo-router. Ohne diese Zeile bricht jedes `npm install` ab.
#
# Dieselbe Einstellung setzt der EAS-Build über NPM_CONFIG_LEGACY_PEER_DEPS.
legacy-peer-deps=true
