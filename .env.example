# Kopieren nach .env und Werte aus dem Supabase-Dashboard eintragen.
# https://supabase.com/dashboard/project/_/settings/api

EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY
EXPO_PUBLIC_WEB_ADMIN_URL=https://serlo-web.vercel.app/admin

# Optional fuer Production-Stability-Smoke (disposable Web-Testaccount).
STABILITY_AUTH_EMAIL=
STABILITY_AUTH_PASSWORD=
STABILITY_SITE_URL=https://serlo-web.vercel.app
